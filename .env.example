DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/lease_auto
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Auth0 (connexion à l'administration)
AUTH0_DOMAIN=lease-auto.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# E-mails (Resend) — sans clé, les e-mails sont affichés dans la console
RESEND_API_KEY=
EMAIL_FROM=contact@lease-auto.fr

# Tâche planifiée Vercel (/api/cron) : openssl rand -hex 24
CRON_SECRET=

# Google (SEO-07) : mesure d’audience GA4 et validation Search Console
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Stockage des justificatifs et photos en ligne (Vercel Blob). Sans jeton sur Vercel, les formulaires n'envoient pas de fichiers.
BLOB_READ_WRITE_TOKEN=

# Avis Google (pnpm sync:avis) : clé Google Cloud avec « Places API (New) », et identifiant de la fiche
# (laisser vide au premier lancement : le script affiche les fiches trouvées).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Accès démo sans Auth0 (/dev/acces?code=…), 12 caractères minimum. À SUPPRIMER avant la mise en ligne.
DEMO_ACCESS_CODE=
